# Optional for simulated chat; required for attempted live Claude calls.
# Get a key from Anthropic Console > API Keys: https://console.anthropic.com/settings/keys
# Replace the empty value only in your private .env file.
ANTHROPIC_API_KEY=

# Required for the public demo. Use the fictional notes included in this repository.
# No account or key needed; directory: example-vault/ in this repository.
# For private use, set an external vault path in your own ignored .env file.
VAULT_PATH=./example-vault

# Optional local SQLite session store. No account or key needed.
# The Bridge creates the parent directory and database on first use.
DB_PATH=./.data/bridge.db

# Optional context-token limit. No account or key needed.
MAX_CONTEXT_TOKENS=16000
